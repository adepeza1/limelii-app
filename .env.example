# Copy this file to .env.local and fill in the values.
# .env.local is gitignored and will only be used by `npm run dev` on your laptop.
#
# For local development, create a SEPARATE Kinde application (do not reuse
# your production Kinde credentials). See README.md "Local Development".

# --- Kinde (required) ---
# From your Kinde dev application's "Details" page.
KINDE_CLIENT_ID=
KINDE_CLIENT_SECRET=
# Your Kinde subdomain, e.g. https://your-tenant.kinde.com
KINDE_ISSUER_URL=
# Must match what you registered in Kinde for local dev.
KINDE_SITE_URL=http://localhost:3000
KINDE_POST_LOGIN_REDIRECT_URL=http://localhost:3000/auth/callback
KINDE_POST_LOGOUT_REDIRECT_URL=http://localhost:3000

# --- Mixpanel (optional) ---
# Leave blank to disable analytics in dev.
NEXT_PUBLIC_MIXPANEL_TOKEN=

# Weather is served by Apple WeatherKit via the Xano backend (no local key needed).

# --- Right Now (live "available now" feed) ---
# Set to 1 to enable the Right Now feed locally; unset/0 keeps the "Coming soon"
# placeholder (production default).
NEXT_PUBLIC_RIGHT_NOW=
# Ticketmaster Discovery API "Consumer Key" — powers the Events category.
# Free at https://developer.ticketmaster.com (server-side only, never exposed).
TICKETMASTER_API_KEY=
# Eventbrite is NOT used for discovery (their public event search was removed
# ~2019). Kept only if you later list your own org's events.
EVENTBRITE_API_KEY=
